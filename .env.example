# 服务器配置
PORT=3000
NODE_ENV=development

# JWT 密钥（生产环境请更换为随机长字符串）
JWT_SECRET=change-me-to-a-random-long-string

# 管理员账号（首次启动自动创建）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password

# 邮件配置
# 开发模式用 ethereal（测试邮件，不会真正发送，仅生成预览链接）
#   MAIL_SERVICE=ethereal
# 生产模式用真实 SMTP（网易163 示例，授权码 ≠ 登录密码）：
#   1) 登录邮箱网页端 → 设置 → 开启 SMTP/POP3 → 获取 16 位授权码
#   2) 把下面 MAIL_SERVICE 改成 163（任意非 ethereal 值均可），并填好 USER/PASS
MAIL_SERVICE=ethereal
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USER=your-work-email@163.com
SMTP_PASS=your-smtp-auth-code

# 前端URL（用于邮件中的链接）
APP_URL=http://localhost:3000
