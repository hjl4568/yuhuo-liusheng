# ============================================================
# 长夜余火 · 生产环境变量模板
# 复制本文件为 .env.prod（同目录），填上真实值，再跑部署。
# .env.prod 已被 .gitignore 排除，绝不会进 GitHub。
# ============================================================

# 运行模式
NODE_ENV=production

# 邮件发送（163 邮箱）
# MAIL_SERVICE 填 163；下面三项为 SMTP 服务器信息
MAIL_SERVICE=163
SMTP_HOST=smtp.163.com
SMTP_PORT=465
# 发件/收件都用项目邮箱
SMTP_USER=changyeyuhuo2026@163.com
# ⚠️ 这里是 163 邮箱的「授权码」，不是登录密码！
SMTP_PASS=填你的163授权码
# 用户登记意向、赞赏通知都发到这个邮箱
WORK_MAIL=changyeyuhuo2026@163.com

# 后台登录（建议改成强密码）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=改成强密码

# JWT 签名密钥：随便一长串随机字符即可，例如 openssl rand -hex 32
JWT_SECRET=填一段随机字符串

# 对外访问地址：备案绑域名后填 https://你的域名（示例已填 emberspeech.com）
APP_URL=https://emberspeech.com

# 允许跨域的来源（逗号分隔）。前后端同域时其实可不填，但填上与域名一致更稳。
# 例：https://emberspeech.com,https://www.emberspeech.com
CORS_ORIGINS=https://emberspeech.com,https://www.emberspeech.com

# 端口（容器内固定 3000）
PORT=3000
